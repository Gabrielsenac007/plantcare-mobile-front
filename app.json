{
  "expo": {
    "name": "PlantCare",
    "slug": "plantcare-mobile",
    "version": "1.0.0",
    "scheme": "plantcaremobile",
    "userInterfaceStyle": "light",
    "orientation": "default",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.plantcare.mobile"
    }
  }
}
